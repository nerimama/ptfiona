---
import BaseLayout from '../layouts/BaseLayout.astro';
import { COMPANY_INFO, SERVICES, EQUIPMENT_FLEET } from '../data/companyData';
import { Search, Wrench, Ship, Anchor, MapPin, CheckCircle2, ShieldCheck, Cpu, ArrowRight, PhoneCall } from 'lucide-astro';
---

<BaseLayout title={`Layanan & Peralatan Equipment - ${COMPANY_INFO.name}`} description="Rincian 5 pilar layanan commercial diving, inspeksi NDT, perbaikan kapal bawah laut, hydrographic surveying, dan 20 perlengkapan diving fleet PT. Fiona Lintas Servis.">
  <!-- PAGE HEADER HERO -->
  <section class="relative py-20 bg-white border-b border-slate-200">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10 text-center">
      <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-navy-50 text-navy-900 text-xs font-bold uppercase tracking-wider border border-navy-200 mb-4">
        Solusi Komprehensif
      </div>
      <h1 class="text-3xl sm:text-5xl font-extrabold text-navy-950 tracking-tight">
        Layanan Teknis & <span class="text-gold-600">Equipment Fleet</span>
      </h1>
      <p class="text-slate-600 text-base sm:text-lg max-w-2xl mx-auto mt-4 leading-relaxed">
        Layanan inspeksi subsea, perbaikan struktur maritim, UWILD survey, dan pemetaan hydrographic didukung 20+ perlengkapan selam standar internasional.
      </p>
    </div>
  </section>

  <!-- 5 MAIN SERVICES DETAILED BREAKDOWN WITH REAL SERVICE PHOTOS -->
  <section class="py-20 bg-slate-50">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 space-y-16">
      {SERVICES.map((service, idx) => (
        <div id={service.id} class="p-8 sm:p-10 bg-white border border-slate-200 rounded-3xl space-y-8 scroll-mt-28 relative overflow-hidden shadow-lg">
          <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 items-center border-b border-slate-200 pb-8">
            <!-- Left Header & Info -->
            <div class="lg:col-span-7 space-y-4">
              <div class="flex items-center gap-4">
                <div class="w-14 h-14 rounded-2xl bg-navy-900 text-gold-400 flex items-center justify-center shadow-md flex-shrink-0">
                  {idx === 0 && <Search class="w-7 h-7" />}
                  {idx === 1 && <Wrench class="w-7 h-7" />}
                  {idx === 2 && <Ship class="w-7 h-7" />}
                  {idx === 3 && <Anchor class="w-7 h-7" />}
                  {idx === 4 && <MapPin class="w-7 h-7" />}
                </div>
                <div>
                  <span class="text-xs font-mono font-bold text-gold-600 uppercase tracking-widest">Pilar Layanan 0{idx + 1}</span>
                  <h2 class="text-2xl sm:text-3xl font-extrabold text-navy-950 tracking-tight">{service.title}</h2>
                </div>
              </div>

              <p class="text-slate-700 text-base leading-relaxed">
                {service.shortDesc}
              </p>

              <div>
                <a
                  href="https://wa.me/6281372154234"
                  target="_blank"
                  rel="noopener noreferrer"
                  class="inline-flex items-center justify-center px-6 py-3 text-xs font-extrabold text-navy-950 bg-gold-400 hover:bg-gold-500 rounded-xl transition-colors shadow-sm"
                >
                  Inkuiri Layanan Ini
                  <ArrowRight class="w-4 h-4 ml-1.5" />
                </a>
              </div>
            </div>

            <!-- Right Image Showcase -->
            <div class="lg:col-span-5">
              <div class="relative h-64 sm:h-72 rounded-2xl overflow-hidden border border-slate-200 shadow-md group">
                <img
                  src={service.image}
                  alt={service.title}
                  class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500"
                />
                <div class="absolute inset-0 bg-gradient-to-t from-navy-950/60 via-transparent to-transparent"></div>
                <span class="absolute bottom-3 left-3 text-xs font-bold text-white bg-navy-900/90 px-3 py-1 rounded-md">
                  PT. Fiona Operational Asset
                </span>
              </div>
            </div>
          </div>

          <!-- Subcategories Grid -->
          {service.subcategories && (
            <div class="grid grid-cols-1 md:grid-cols-2 gap-6 pt-2">
              {service.subcategories.map((sub) => (
                <div class="p-6 bg-slate-50 border border-slate-200/80 rounded-2xl space-y-3">
                  <h3 class="text-sm font-extrabold text-navy-900 uppercase tracking-wider flex items-center gap-2">
                    <span class="w-2 h-2 rounded-full bg-gold-500"></span>
                    {sub.title}
                  </h3>
                  <ul class="space-y-2 text-xs text-slate-700">
                    {sub.items.map((item) => (
                      <li class="flex items-start gap-2">
                        <CheckCircle2 class="w-4 h-4 text-emerald-600 flex-shrink-0 mt-0.5" />
                        <span class="leading-relaxed">{item}</span>
                      </li>
                    ))}
                  </ul>
                </div>
              ))}
            </div>
          )}

          <!-- Hydrographic Special Callout Card -->
          {service.id === 'hydrographic-surveying' && (
            <div class="p-6 bg-navy-900 text-white rounded-2xl space-y-3 shadow-md">
              <div class="flex items-center gap-3">
                <Cpu class="w-6 h-6 text-cyan-300" />
                <h3 class="text-base font-bold text-white">Kapabilitas Khusus Hydrographic & Survey Vessel</h3>
              </div>
              <p class="text-xs text-slate-200 leading-relaxed">
                Tim surveyor hydrographic kami berorientasi pada standar nasional & internasional untuk survei kedalaman bathymetric dan investigasi alur pipa offshore. Didukung peralatan GNSS RTK state-of-the-art, kapal survei tersertifikasi kelas 2C, dual-frequency & multi-beam sounder, serta perangkat lunak reduksi data presisi tinggi.
              </p>
            </div>
          )}
        </div>
      ))}
    </div>
  </section>

  <!-- COMPLETE 20-ITEM EQUIPMENT FLEET SHOWCASE -->
  <section class="py-20 bg-white border-t border-b border-slate-200">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center max-w-3xl mx-auto mb-16 space-y-4">
        <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-gold-50 text-gold-700 text-xs font-bold uppercase tracking-wider border border-gold-200">
          Standard Technical Assets
        </div>
        <h2 class="text-3xl font-bold text-navy-950 tracking-tight">
          Daftar Lengkap Armada & Peralatan Selam (Equipment Fleet)
        </h2>
        <p class="text-slate-600 text-sm">
          Seluruh 20 unit perlengkapan teknis diservis berkala untuk menjamin keamanan operasi di lapangan.
        </p>
      </div>

      <div class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-3 lg:grid-cols-4 gap-4">
        {EQUIPMENT_FLEET.map((item) => (
          <div class="p-5 bg-slate-50 border border-slate-200/80 hover:border-gold-500/50 rounded-2xl space-y-2 transition-all hover:-translate-y-0.5 shadow-sm">
            <div class="flex items-center justify-between text-xs">
              <span class="px-2 py-0.5 rounded bg-white text-navy-900 font-mono font-bold text-[10px] border border-slate-200">#0{item.id}</span>
              <span class="text-[10px] text-slate-500 uppercase tracking-wider font-semibold">{item.category}</span>
            </div>
            <h3 class="text-sm font-extrabold text-navy-950">{item.name}</h3>
            {item.description && (
              <p class="text-xs text-slate-600 leading-normal">{item.description}</p>
            )}
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- CTA CONTACT -->
  <section class="py-16 bg-slate-50">
    <div class="max-w-4xl mx-auto px-4 text-center space-y-6">
      <h2 class="text-2xl sm:text-3xl font-bold text-navy-950">
        Membutuhkan Peralatan Spesifik atau Diver Terlatih?
      </h2>
      <p class="text-slate-600 text-sm">
        Konsultasikan kebutuhan spesifikasi teknis proyek subsea Anda bersama tim operasional PT. Fiona Lintas Servis.
      </p>
      <div class="pt-2">
        <a
          href="https://wa.me/6281372154234"
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex items-center justify-center px-8 py-3.5 text-xs font-extrabold text-navy-950 bg-gold-400 hover:bg-gold-500 rounded-xl transition-all shadow-md"
        >
          <PhoneCall class="w-4 h-4 mr-2" />
          Hubungi Operations (Sukri: +62-813-7215-4234)
        </a>
      </div>
    </div>
  </section>
</BaseLayout>
