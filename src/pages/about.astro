---
import BaseLayout from '../layouts/BaseLayout.astro';
import { COMPANY_INFO, VISION_MISSION, CORE_VALUES } from '../data/companyData';
import { Anchor, Shield, Target, Users, MapPin, Award, CheckCircle2, ChevronRight } from 'lucide-astro';
---

<BaseLayout title={`Tentang Kami - ${COMPANY_INFO.name}`} description="Profil lengkap PT. Fiona Lintas Servis, visi & misi, nilai utama perusahaan, serta keunggulan tim diver dan subsea engineer kami di Batam.">
  <!-- PAGE HEADER HERO -->
  <section class="relative py-20 bg-slate-950 border-b border-slate-800 overflow-hidden">
    <div class="absolute inset-0 bg-gradient-to-br from-navy-950 via-slate-950 to-navy-900 opacity-90"></div>
    <div class="absolute inset-0 bg-[radial-gradient(ellipse_at_top,_var(--tw-gradient-stops))] from-ocean-600/20 via-transparent to-transparent"></div>
    
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10 text-center">
      <div class="inline-flex items-center gap-2 px-3 py-1 rounded-md bg-gold-500/10 text-gold-400 text-xs font-bold uppercase tracking-wider border border-gold-500/20 mb-4">
        Profil Perusahaan
      </div>
      <h1 class="text-3xl sm:text-5xl font-extrabold text-white tracking-tight">
        Tentang <span class="text-gold-400">PT. Fiona Lintas Servis</span>
      </h1>
      <p class="text-slate-300 text-base sm:text-lg max-w-2xl mx-auto mt-4 leading-relaxed">
        Penyedia layanan commercial diving, marine salvage, inspeksi subsea, dan hydrographic surveying terpercaya berbasis di Batam, Indonesia.
      </p>
    </div>
  </section>

  <!-- DETAILED ABOUT US & STATS -->
  <section class="py-20 bg-slate-950">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 items-center">
        <div class="lg:col-span-7 space-y-6">
          <h2 class="text-2xl sm:text-3xl font-bold text-white tracking-tight leading-snug">
            Komitmen Tinggi dalam Kualitas Pekerjaan Bawah Laut & Marine Engineering
          </h2>

          <p class="text-slate-300 text-sm sm:text-base leading-relaxed">
            <strong class="text-white font-semibold">PT. FIONA LINTAS SERVIS</strong> adalah perusahaan penanaman modal dalam negeri (PMDN) independen yang didirikan di Batam, Kepulauan Riau. Perusahaan kami mengkhususkan diri pada bidang penyelaman komersial, penyelamatan kapal (<strong class="text-gold-400">Marine Salvage</strong>), pemeliharaan fasilitas lepas pantai, dan pemetaan kedalaman laut (<strong class="text-cyan-400">Hydrographic Surveying</strong>).
          </p>

          <p class="text-slate-400 text-sm leading-relaxed">
            Dikelola oleh jajaran ahli maritim yang berpengalaman luas di industri minyak & gas lepas pantai, perkapalan internasional, dan teknik sipil bawah laut, kami berdedikasi memberikan solusi cepat, tepat biaya, dan aman sesuai standar K3 maritim tertinggi.
          </p>

          <div class="p-6 bg-slate-900 border border-slate-800 rounded-2xl space-y-3">
            <h3 class="text-base font-bold text-white flex items-center gap-2">
              <Shield class="w-5 h-5 text-gold-400" />
              Keunggulan Utama Kami
            </h3>
            <ul class="grid grid-cols-1 sm:grid-cols-2 gap-2 text-xs text-slate-300">
              <li class="flex items-center gap-2">
                <CheckCircle2 class="w-4 h-4 text-emerald-400 flex-shrink-0" />
                <span>Penyelam Komersial Bersertifikat</span>
              </li>
              <li class="flex items-center gap-2">
                <CheckCircle2 class="w-4 h-4 text-emerald-400 flex-shrink-0" />
                <span>Peralatan Umbilical & CCTV Lengkap</span>
              </li>
              <li class="flex items-center gap-2">
                <CheckCircle2 class="w-4 h-4 text-emerald-400 flex-shrink-0" />
                <span>Metode NDT CP, UT, MPI & Eddy Current</span>
              </li>
              <li class="flex items-center gap-2">
                <CheckCircle2 class="w-4 h-4 text-emerald-400 flex-shrink-0" />
                <span>GNSS Multi-beam Sounder 2C Vessel</span>
              </li>
            </ul>
          </div>
        </div>

        <!-- Vision & Mission Visual Card -->
        <div class="lg:col-span-5 space-y-6">
          <div class="p-6 bg-gradient-to-br from-navy-950 to-slate-900 border border-slate-800 rounded-2xl shadow-xl space-y-4">
            <div class="flex items-center gap-3 border-b border-slate-800 pb-3">
              <Target class="w-6 h-6 text-gold-400" />
              <h3 class="text-lg font-bold text-white">Visi Perusahaan</h3>
            </div>
            <p class="text-sm text-slate-200 italic leading-relaxed">
              "{VISION_MISSION.vision}"
            </p>
          </div>

          <div class="p-6 bg-gradient-to-br from-slate-900 to-navy-950 border border-slate-800 rounded-2xl shadow-xl space-y-4">
            <div class="flex items-center gap-3 border-b border-slate-800 pb-3">
              <Award class="w-6 h-6 text-cyan-400" />
              <h3 class="text-lg font-bold text-white">Misi Perusahaan</h3>
            </div>
            <ul class="space-y-3 text-xs text-slate-300">
              {VISION_MISSION.mission.map((item, idx) => (
                <li class="flex items-start gap-2.5">
                  <span class="w-5 h-5 rounded-full bg-slate-800 text-gold-400 font-bold flex items-center justify-center text-[10px] flex-shrink-0 mt-0.5">
                    0{idx + 1}
                  </span>
                  <span class="leading-relaxed">{item}</span>
                </li>
              ))}
            </ul>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- 6 CORE VALUES INTERACTIVE GRID -->
  <section class="py-20 bg-slate-900/60 border-t border-b border-slate-800">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center max-w-3xl mx-auto mb-16 space-y-4">
        <div class="inline-flex items-center gap-2 px-3 py-1 rounded-md bg-gold-500/10 text-gold-400 text-xs font-bold uppercase tracking-wider border border-gold-500/20">
          Landasan Kerja Perusahaan
        </div>
        <h2 class="text-3xl font-bold text-white tracking-tight">
          6 Nilai Utama (Core Values)
        </h2>
        <p class="text-slate-400 text-sm">
          Menjadi pedoman seluruh manajemen dan tim operasional dalam melayani setiap klien.
        </p>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
        {CORE_VALUES.map((val, idx) => (
          <div class="p-6 bg-slate-950 border border-slate-800 hover:border-gold-500/50 rounded-2xl transition-all duration-300 hover:-translate-y-1 space-y-3">
            <div class="flex items-center justify-between">
              <span class="w-8 h-8 rounded-lg bg-navy-900 text-gold-400 font-bold flex items-center justify-center text-xs border border-navy-800">
                0{idx + 1}
              </span>
              <Users class="w-5 h-5 text-slate-400" />
            </div>
            <h3 class="text-lg font-bold text-white">{val.title}</h3>
            <p class="text-xs text-slate-400 leading-relaxed">{val.description}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- OFFICE & WORKSHOP FACILITY SECTION -->
  <section class="py-20 bg-slate-950">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="p-8 sm:p-12 bg-gradient-to-r from-navy-950 via-slate-900 to-navy-950 border border-slate-800 rounded-3xl grid grid-cols-1 lg:grid-cols-12 gap-8 items-center">
        <div class="lg:col-span-8 space-y-4">
          <div class="inline-flex items-center gap-2 text-xs font-bold text-gold-400 uppercase tracking-widest">
            <MapPin class="w-4 h-4 text-gold-400" />
            Kantor Utama & Workshop Batam
          </div>
          <h2 class="text-2xl sm:text-3xl font-bold text-white">
            Siap Mendukung Operasional Maritim & Offshore
          </h2>
          <p class="text-slate-300 text-sm leading-relaxed">
            Fasilitas kantor dan workshop kami terletak di Komplek Pertokoan Tiban Lestari, Sekupang, Batam. Dilengkapi dengan ruang penyimpanan tabung udara bertekanan tinggi (HP Charging Compressor), sistem umbilical, kamera video bawah laut, dan peralatan pemotong exothermic.
          </p>
          <div class="text-xs text-slate-400">
            <strong>Alamat Lengkap:</strong> {COMPANY_INFO.address}
          </div>
        </div>

        <div class="lg:col-span-4 flex flex-col sm:flex-row lg:flex-col gap-3">
          <a
            href="/contact"
            class="inline-flex items-center justify-center px-6 py-3.5 text-xs font-bold text-navy-950 bg-gold-400 hover:bg-gold-300 rounded-xl transition-colors shadow-glow text-center"
          >
            Hubungi Kantor Batam
          </a>
          <a
            href="/services"
            class="inline-flex items-center justify-center px-6 py-3.5 text-xs font-bold text-white bg-slate-800 hover:bg-slate-700 border border-slate-700 rounded-xl transition-colors text-center"
          >
            Lihat Fleet Peralatan Kami
          </a>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>
