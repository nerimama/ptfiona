---
import BaseLayout from '../layouts/BaseLayout.astro';
import { COMPANY_INFO } from '../data/companyData';
import { MapPin, Phone, Mail, MessageSquare, Send, UserCheck } from 'lucide-astro';
---

<BaseLayout title={`Kontak Kami - ${COMPANY_INFO.name}`} description="Hubungi PT. Fiona Lintas Servis di Sekupang, Batam. Kontak telepon, WhatsApp direct Sukri & Fionna, email resmi, dan alamat kantor & workshop.">
  <!-- PAGE HEADER HERO -->
  <section class="relative py-20 bg-white border-b border-slate-200">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10 text-center">
      <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-navy-50 text-navy-900 text-xs font-bold uppercase tracking-wider border border-navy-200 mb-4">
        Respon Cepat 24/7
      </div>
      <h1 class="text-3xl sm:text-5xl font-extrabold text-navy-950 tracking-tight">
        Hubungi Tim <span class="text-gold-600">PT. Fiona Lintas Servis</span>
      </h1>
      <p class="text-slate-600 text-base sm:text-lg max-w-2xl mx-auto mt-4 leading-relaxed">
        Silakan hubungi tim operasional dan commercial kami untuk penawaran harga, konsultasi teknis, atau penanganan darurat bawah laut.
      </p>
    </div>
  </section>

  <!-- MAIN CONTACT CONTENT GRID -->
  <section class="py-20 bg-slate-50">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-12">
        <!-- Contact Info & Direct Cards (5 cols) -->
        <div class="lg:col-span-5 space-y-8">
          <div class="p-6 bg-white border border-slate-200 rounded-3xl space-y-6 shadow-md">
            <h2 class="text-xl font-bold text-navy-950 border-b border-slate-100 pb-3">Informasi Kantor Utama</h2>
            
            <ul class="space-y-4 text-xs text-slate-700">
              <li class="flex items-start gap-3">
                <div class="p-2 rounded-lg bg-navy-50 text-navy-900 border border-navy-100 flex-shrink-0 mt-0.5">
                  <MapPin class="w-4 h-4 text-gold-600" />
                </div>
                <div>
                  <strong class="text-navy-950 block font-semibold mb-0.5">Alamat Lengkap:</strong>
                  <span class="leading-relaxed text-slate-600">{COMPANY_INFO.address}</span>
                </div>
              </li>

              <li class="flex items-start gap-3">
                <div class="p-2 rounded-lg bg-navy-50 text-navy-900 border border-navy-100 flex-shrink-0">
                  <Phone class="w-4 h-4 text-gold-600" />
                </div>
                <div>
                  <strong class="text-navy-950 block font-semibold mb-0.5">Telepon & Fax Kantor:</strong>
                  <span>Phone: <a href={`tel:${COMPANY_INFO.phone}`} class="text-gold-600 font-bold hover:underline">{COMPANY_INFO.phone}</a></span>
                  <span class="block text-slate-600">Fax: {COMPANY_INFO.fax}</span>
                </div>
              </li>

              <li class="flex items-start gap-3">
                <div class="p-2 rounded-lg bg-navy-50 text-navy-900 border border-navy-100 flex-shrink-0">
                  <Mail class="w-4 h-4 text-gold-600" />
                </div>
                <div>
                  <strong class="text-navy-950 block font-semibold mb-0.5">Email Resmi:</strong>
                  <div class="space-y-0.5">
                    <a href={`mailto:${COMPANY_INFO.emails[0]}`} class="block text-ocean-600 font-semibold hover:underline">{COMPANY_INFO.emails[0]}</a>
                    <a href={`mailto:${COMPANY_INFO.emails[1]}`} class="block text-ocean-600 font-semibold hover:underline">{COMPANY_INFO.emails[1]}</a>
                  </div>
                </div>
              </li>
            </ul>
          </div>

          <!-- Dedicated Contact Person Cards -->
          <div class="space-y-4">
            <h3 class="text-xs font-bold text-slate-500 uppercase tracking-wider">Kontak Person Langsung</h3>
            
            {COMPANY_INFO.contactPersons.map((cp) => (
              <div class="p-5 bg-white border border-slate-200 hover:border-gold-500/50 rounded-2xl space-y-3 transition-colors shadow-md">
                <div class="flex items-center justify-between">
                  <div>
                    <h4 class="text-base font-extrabold text-navy-950">{cp.name}</h4>
                    <p class="text-xs text-gold-600 font-semibold">{cp.role}</p>
                  </div>
                  <UserCheck class="w-6 h-6 text-gold-500" />
                </div>
                <p class="text-xs text-slate-700 font-mono font-semibold">No. Telp / WA: {cp.phone}</p>
                <div class="flex items-center gap-2 pt-1">
                  <a
                    href={`tel:${cp.phone}`}
                    class="flex-1 text-center py-2 px-3 text-xs font-bold text-slate-800 bg-slate-100 hover:bg-slate-200 rounded-lg transition-colors border border-slate-300"
                  >
                    Telepon Direct
                  </a>
                  <a
                    href={cp.waLink}
                    target="_blank"
                    rel="noopener noreferrer"
                    class="flex-1 flex items-center justify-center gap-1.5 py-2 px-3 text-xs font-bold text-navy-950 bg-gold-400 hover:bg-gold-500 rounded-lg transition-colors shadow-sm"
                  >
                    <MessageSquare class="w-3.5 h-3.5" />
                    WhatsApp
                  </a>
                </div>
              </div>
            ))}
          </div>
        </div>

        <!-- Interactive Inquiry Form (7 cols) -->
        <div class="lg:col-span-7">
          <div class="p-8 sm:p-10 bg-white border border-slate-200 rounded-3xl space-y-6 shadow-xl">
            <div>
              <h2 class="text-2xl font-bold text-navy-950">Kirim Formulir Permintaan Penawaran</h2>
              <p class="text-xs text-slate-600 mt-1">
                Isi rincian kebutuhan spesifikasi kapal, proyek subsea, atau jadwal survei Anda di bawah ini.
              </p>
            </div>

            <form id="contact-form" class="space-y-4">
              <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
                <div>
                  <label for="name" class="block text-xs font-bold text-slate-700 uppercase tracking-wider mb-1.5">Nama Lengkap *</label>
                  <input
                    type="text"
                    id="name"
                    name="name"
                    required
                    placeholder="Contoh: Budi Santoso"
                    class="w-full px-4 py-3 bg-slate-50 border border-slate-300 rounded-xl text-sm text-slate-900 focus:outline-none focus:border-gold-500 transition-colors"
                  />
                </div>
                <div>
                  <label for="company" class="block text-xs font-bold text-slate-700 uppercase tracking-wider mb-1.5">Perusahaan / Kapal *</label>
                  <input
                    type="text"
                    id="company"
                    name="company"
                    required
                    placeholder="Contoh: PT. Seaswan Shipping / MV. Dawn"
                    class="w-full px-4 py-3 bg-slate-50 border border-slate-300 rounded-xl text-sm text-slate-900 focus:outline-none focus:border-gold-500 transition-colors"
                  />
                </div>
              </div>

              <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
                <div>
                  <label for="phone" class="block text-xs font-bold text-slate-700 uppercase tracking-wider mb-1.5">Nomor HP / WhatsApp *</label>
                  <input
                    type="tel"
                    id="phone"
                    name="phone"
                    required
                    placeholder="+62 812 XXXX XXXX"
                    class="w-full px-4 py-3 bg-slate-50 border border-slate-300 rounded-xl text-sm text-slate-900 focus:outline-none focus:border-gold-500 transition-colors"
                  />
                </div>
                <div>
                  <label for="service" class="block text-xs font-bold text-slate-700 uppercase tracking-wider mb-1.5">Jenis Layanan Dibutuhkan *</label>
                  <select
                    id="service"
                    name="service"
                    required
                    class="w-full px-4 py-3 bg-slate-50 border border-slate-300 rounded-xl text-sm text-slate-900 focus:outline-none focus:border-gold-500 transition-colors"
                  >
                    <option value="">-- Pilih Layanan --</option>
                    <option value="Ship Service (UWILD / Hull Cleaning)">Ship Service (UWILD / Hull Cleaning)</option>
                    <option value="Inspection Service (NDT / Pipeline)">Inspection Service (NDT / Pipeline)</option>
                    <option value="Underwater Repair & Maintenance">Underwater Repair & Maintenance</option>
                    <option value="Underwater Works (Welding / Anode)">Underwater Works (Welding / Anode)</option>
                    <option value="Hydrographic Surveying">Hydrographic Surveying</option>
                    <option value="Lainnya">Lainnya / Emergency Salvage</option>
                  </select>
                </div>
              </div>

              <div>
                <label for="message" class="block text-xs font-bold text-slate-700 uppercase tracking-wider mb-1.5">Rincian Pesan & Lokasi Proyek *</label>
                <textarea
                  id="message"
                  name="message"
                  rows="5"
                  required
                  placeholder="Tuliskan spesifikasi pekerjaan, posisi kapal/anchorage, dan perkiraan tanggal pelaksanaan..."
                  class="w-full px-4 py-3 bg-slate-50 border border-slate-300 rounded-xl text-sm text-slate-900 focus:outline-none focus:border-gold-500 transition-colors resize-none"
                ></textarea>
              </div>

              <button
                type="submit"
                class="w-full py-4 text-xs font-extrabold uppercase tracking-widest text-navy-950 bg-gold-400 hover:bg-gold-500 rounded-xl transition-all shadow-md flex items-center justify-center gap-2"
              >
                <Send class="w-4 h-4" />
                Kirim Inkuiri via WhatsApp Direct
              </button>
            </form>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- GOOGLE MAP LOCATION EMBED SECTION -->
  <section class="py-16 bg-white border-t border-b border-slate-200">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 space-y-6">
      <div class="flex items-center justify-between">
        <div>
          <h3 class="text-xl font-bold text-navy-950">Peta Lokasi Kantor Batam</h3>
          <p class="text-xs text-slate-600 mt-0.5">Sekupang, Batam - Kepulauan Riau, Indonesia</p>
        </div>
        <a
          href="https://maps.google.com/?q=Tiban+Lestari+Batam+Sekupang"
          target="_blank"
          rel="noopener noreferrer"
          class="text-xs text-gold-600 font-bold hover:underline flex items-center gap-1"
        >
          <span>Buka di Google Maps</span>
          <MapPin class="w-3.5 h-3.5" />
        </a>
      </div>

      <div class="w-full h-80 bg-slate-100 border border-slate-200 rounded-2xl overflow-hidden relative shadow-sm">
        <iframe
          title="Google Map Sekupang Batam"
          src="https://www.google.com/maps/embed?pb=!1m18!1m12!1m3!1d3989.056345864197!2d103.9682!3d1.1165!2m3!1f0!2f0!3f0!3m2!1i1024!2i768!4f13.1!3m3!1m2!1s0x0%3A0x0!2zMcKwMDYnNTkuNCJOIDEwM8KwNTgnMDUuNSJF!5e0!3m2!1sen!2sid!4v1620000000000!5m2!1sen!2sid"
          width="100%"
          height="100%"
          style="border:0;"
          allowfullscreen=""
          loading="lazy"
        ></iframe>
      </div>
    </div>
  </section>

  <!-- FORM SCRIPT -->
  <script>
    const form = document.getElementById('contact-form') as HTMLFormElement;
    if (form) {
      form.addEventListener('submit', (e) => {
        e.preventDefault();
        const name = (document.getElementById('name') as HTMLInputElement).value;
        const company = (document.getElementById('company') as HTMLInputElement).value;
        const phone = (document.getElementById('phone') as HTMLInputElement).value;
        const service = (document.getElementById('service') as HTMLSelectElement).value;
        const message = (document.getElementById('message') as HTMLTextAreaElement).value;

        const text = `Halo PT. Fiona Lintas Servis,%0A%0ASaya ingin mengajukan inkuiri:%0A- *Nama*: ${name}%0A- *Perusahaan*: ${company}%0A- *No HP*: ${phone}%0A- *Layanan*: ${service}%0A- *Pesan/Proyek*: ${message}`;
        
        window.open(`https://wa.me/6281372154234?text=${text}`, '_blank');
      });
    }
  </script>
</BaseLayout>
