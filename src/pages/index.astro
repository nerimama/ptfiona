                <div>
                  <label for="company" class="block text-xs font-bold text-slate-700 uppercase tracking-wider mb-1.5">Perusahaan / Kapal *</label>
                  <input
                    type="text"
                    id="company"
                    name="company"
                    required
                    placeholder="Contoh: PT. Seaswan Shipping / MV. Dawn"
                    class="w-full px-4 py-3 bg-white border border-slate-300 rounded-xl text-sm text-slate-900 focus:outline-none focus:border-gold-500 transition-colors"
