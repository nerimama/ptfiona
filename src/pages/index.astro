                  >
                    <option value="">-- Pilih Layanan --</option>
                    <option value="Ship Service (UWILD / Hull Cleaning)">Ship Service (UWILD / Hull Cleaning)</option>
                    <option value="Inspection Service (NDT / Pipeline)">Inspection Service (NDT / Pipeline)</option>
                    <option value="Underwater Repair & Maintenance">Underwater Repair & Maintenance</option>
