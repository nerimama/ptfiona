---
import BaseLayout from '../layouts/BaseLayout.astro';
import { COMPANY_INFO, VISION_MISSION, CORE_VALUES, SERVICES, EQUIPMENT_FLEET, PROJECT_TRACK_RECORD, CLIENT_LIST } from '../data/companyData';
import { Anchor, Shield, Target, Users, Search, Wrench, Ship, MapPin, ArrowRight, PhoneCall, CheckCircle2, Waves, Award, Cpu, Calendar, UserCheck, Mail, Send, Phone } from 'lucide-astro';
---

<BaseLayout title={`${COMPANY_INFO.name} - Commercial Diving, Marine Salvage & Hydrographic Surveying Batam`}>
  <!-- HERO SECTION - ID: beranda -->
  <section id="beranda" class="relative bg-white overflow-hidden py-16 lg:py-24 border-b border-slate-200 scroll-mt-20">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10">
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 items-center">
        <!-- Hero Text -->
        <div class="lg:col-span-7 space-y-6 text-left">
          <div class="inline-flex items-center gap-2.5 px-3.5 py-1.5 rounded-full bg-navy-50 border border-navy-200 text-navy-900 text-xs font-bold uppercase tracking-wider shadow-xs">
            <Anchor class="w-4 h-4 text-gold-600" />
            <span>Kontraktor Terkemuka Batam & Kepulauan Riau</span>
          </div>

          <!-- Official Logo Showcase in Hero -->
          <div class="mb-2">
            <img src="/logo.png" alt="PT. Fiona Lintas Servis Logo" class="h-16 w-auto object-contain max-w-[260px] sm:max-w-[320px]" />
          </div>

          <h1 class="text-3xl sm:text-5xl lg:text-6xl font-extrabold text-navy-950 tracking-tight leading-tight">
            Marine Salvage & <span class="bg-gradient-to-r from-ocean-600 via-navy-800 to-gold-600 bg-clip-text text-transparent">Subsea Engineering</span>
          </h1>

          <p class="text-base sm:text-lg text-slate-600 max-w-2xl font-normal leading-relaxed">
            Spesialis penyelaman komersial (<strong class="text-navy-900">Commercial Diving</strong>), pembersihan lunas kapal (<strong class="text-navy-900">Underwater Hull Cleaning</strong>), inspeksi <strong class="text-navy-900">UWILD</strong>, perbaikan struktur bawah laut, dan survei <strong class="text-navy-900">Hydrographic Surveying</strong> profesional berbasis di Batam, Indonesia.
          </p>

          <!-- Action Buttons -->
          <div class="flex flex-col sm:flex-row items-center gap-4 pt-2">
            <a
              href="#layanan"
              class="w-full sm:w-auto inline-flex items-center justify-center px-8 py-4 text-sm font-extrabold text-navy-950 uppercase tracking-wider bg-gold-400 hover:bg-gold-500 rounded-xl transition-all duration-300 shadow-md hover:shadow-gold-500/40 transform hover:-translate-y-0.5"
            >
              Explore Services & Fleet
              <ArrowRight class="w-4 h-4 ml-2" />
            </a>
            <a
              href="#kontak"
              class="w-full sm:w-auto inline-flex items-center justify-center px-8 py-4 text-sm font-bold text-slate-800 bg-slate-100 hover:bg-slate-200 border border-slate-300 rounded-xl transition-all duration-300"
            >
              Hubungi Tim Teknis
            </a>
          </div>

          <!-- Trust Badges -->
          <div class="pt-6 border-t border-slate-200 flex flex-wrap items-center gap-6 text-xs text-slate-600">
            <div class="flex items-center gap-2">
              <CheckCircle2 class="w-4.5 h-4.5 text-emerald-600" />
              <span class="font-semibold text-slate-800">Certified Commercial Divers</span>
            </div>
            <div class="flex items-center gap-2">
              <CheckCircle2 class="w-4.5 h-4.5 text-emerald-600" />
              <span class="font-semibold text-slate-800">Class Approved UWILD Surveys</span>
            </div>
            <div class="flex items-center gap-2">
              <CheckCircle2 class="w-4.5 h-4.5 text-emerald-600" />
              <span class="font-semibold text-slate-800">Advanced Subsea Fleet</span>
            </div>
          </div>
        </div>

        <!-- Hero Image Card showcase -->
        <div class="lg:col-span-5 relative">
          <div class="relative mx-auto max-w-md lg:max-w-none">
            <div class="relative bg-white border border-slate-200 rounded-3xl p-3 shadow-2xl space-y-4 overflow-hidden">
              <div class="relative h-72 sm:h-80 rounded-2xl overflow-hidden group">
                <img
                  src="/images/hero.png"
                  alt="PT Fiona Lintas Servis Commercial Diving Operation"
                  class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-700"
                />
                <div class="absolute inset-0 bg-gradient-to-t from-navy-950/80 via-transparent to-transparent"></div>
                <div class="absolute bottom-4 left-4 right-4 text-white">
                  <span class="px-2.5 py-1 rounded bg-gold-500 text-navy-950 text-[10px] font-black uppercase tracking-wider mb-1 inline-block">
                    Operational Excellence
                  </span>
                  <h3 class="text-base font-bold text-white">Kirby Morgan Commercial Diving Helmet & Umbilical Air System</h3>
                </div>
              </div>

              <!-- Quick Info List -->
              <div class="p-4 bg-slate-50 rounded-2xl border border-slate-200/80 space-y-2 text-xs">
                <div class="flex justify-between items-center text-slate-700">
                  <span class="font-bold text-navy-900">Coverage Area:</span>
                  <span class="font-medium">Galang, Batu Ampar, PaxOcean, Bintan, Singapore Strait</span>
                </div>
                <div class="flex justify-between items-center text-slate-700">
                  <span class="font-bold text-navy-900">Standard Response:</span>
                  <span class="font-semibold text-emerald-700">24/7 Rapid Dispatch</span>
                </div>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- STATS HIGHLIGHTS BANNER -->
  <section class="bg-navy-900 text-white py-12 border-b border-navy-800">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="grid grid-cols-2 md:grid-cols-4 gap-8 divide-y md:divide-y-0 md:divide-x divide-navy-800">
        <div class="text-center pt-4 md:pt-0">
          <div class="text-3xl lg:text-4xl font-black text-gold-400 tracking-tight">10+ Tahun</div>
          <div class="text-xs text-slate-300 uppercase tracking-widest mt-1 font-semibold">Pengalaman Maritim</div>
        </div>
        <div class="text-center pt-4 md:pt-0">
          <div class="text-3xl lg:text-4xl font-black text-white tracking-tight">16+ Proyek</div>
          <div class="text-xs text-slate-300 uppercase tracking-widest mt-1 font-semibold">Rekam Jejak Tuntas</div>
        </div>
        <div class="text-center pt-4 md:pt-0">
          <div class="text-3xl lg:text-4xl font-black text-cyan-300 tracking-tight">100% Certified</div>
          <div class="text-xs text-slate-300 uppercase tracking-widest mt-1 font-semibold">Diver & NDT Expert</div>
        </div>
        <div class="text-center pt-4 md:pt-0">
          <div class="text-3xl lg:text-4xl font-black text-gold-400 tracking-tight">24/7 Service</div>
          <div class="text-xs text-slate-300 uppercase tracking-widest mt-1 font-semibold">Respon Darurat Salvage</div>
        </div>
      </div>
    </div>
  </section>

  <!-- TENTANG KAMI & CORE VALUES - ID: tentang -->
  <section id="tentang" class="py-20 bg-slate-50 border-b border-slate-200 scroll-mt-20">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 space-y-16">
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 items-center">
        <div class="lg:col-span-7 space-y-6">
          <div class="inline-flex items-center gap-2 px-3 py-1 rounded-md bg-ocean-50 text-ocean-700 text-xs font-bold uppercase tracking-wider border border-ocean-200">
            Profil Perusahaan
          </div>
          <h2 class="text-3xl sm:text-4xl font-bold text-navy-950 tracking-tight leading-snug">
            Mitra Terpercaya Pekerjaan Bawah Laut & Marine Salvage di Indonesia
          </h2>
          <p class="text-slate-700 text-sm sm:text-base leading-relaxed">
            <strong class="text-navy-900 font-semibold">PT. FIONA LINTAS SERVIS</strong> didirikan di Batam, Kepulauan Riau sebagai perusahaan spesialis pekerjaan bawah laut (<strong class="text-gold-600">Commercial Diving</strong>), penyelamatan kapal (<strong class="text-gold-600">Marine Salvage</strong>), pemeliharaan struktur pelabuhan, dan pemetaan kedalaman laut (<strong class="text-ocean-600">Hydrographic Surveying</strong>).
          </p>
          <p class="text-slate-600 text-sm leading-relaxed">
            Dikelola oleh jajaran ahli maritim yang berpengalaman luas di industri minyak & gas lepas pantai dan perkapalan internasional, kami berdedikasi memberikan solusi cepat, tepat biaya, dan aman sesuai standar K3 maritim tertinggi.
          </p>

          <div class="p-6 bg-white border border-slate-200 rounded-2xl space-y-3 shadow-sm">
            <h3 class="text-base font-bold text-navy-950 flex items-center gap-2">
              <Shield class="w-5 h-5 text-gold-500" />
              Keunggulan Utama Kami
            </h3>
            <ul class="grid grid-cols-1 sm:grid-cols-2 gap-2.5 text-xs text-slate-700">
              <li class="flex items-center gap-2">
                <CheckCircle2 class="w-4 h-4 text-emerald-600 flex-shrink-0" />
                <span>Penyelam Komersial Bersertifikat</span>
              </li>
              <li class="flex items-center gap-2">
                <CheckCircle2 class="w-4 h-4 text-emerald-600 flex-shrink-0" />
                <span>Peralatan Umbilical & CCTV Lengkap</span>
              </li>
              <li class="flex items-center gap-2">
                <CheckCircle2 class="w-4 h-4 text-emerald-600 flex-shrink-0" />
                <span>Metode NDT CP, UT, MPI & Eddy Current</span>
              </li>
              <li class="flex items-center gap-2">
                <CheckCircle2 class="w-4 h-4 text-emerald-600 flex-shrink-0" />
                <span>GNSS Multi-beam Sounder 2C Vessel</span>
              </li>
            </ul>
          </div>
        </div>

        <!-- Vision & Mission Cards -->
        <div class="lg:col-span-5 space-y-6">
          <div class="p-6 bg-white border border-slate-200 rounded-2xl shadow-md space-y-4">
            <div class="flex items-center gap-3 border-b border-slate-100 pb-3">
              <Target class="w-6 h-6 text-gold-600" />
              <h3 class="text-lg font-bold text-navy-950">Visi Perusahaan</h3>
            </div>
            <p class="text-sm text-slate-700 italic leading-relaxed">
              "{VISION_MISSION.vision}"
            </p>
          </div>

          <div class="p-6 bg-white border border-slate-200 rounded-2xl shadow-md space-y-4">
            <div class="flex items-center gap-3 border-b border-slate-100 pb-3">
              <Award class="w-6 h-6 text-ocean-600" />
              <h3 class="text-lg font-bold text-navy-950">Misi Perusahaan</h3>
            </div>
            <ul class="space-y-3 text-xs text-slate-700">
              {VISION_MISSION.mission.map((item, idx) => (
                <li class="flex items-start gap-2.5">
                  <span class="w-5 h-5 rounded-full bg-navy-50 text-navy-900 font-bold flex items-center justify-center text-[10px] flex-shrink-0 mt-0.5 border border-navy-100">
                    0{idx + 1}
                  </span>
                  <span class="leading-relaxed">{item}</span>
                </li>
              ))}
            </ul>
          </div>
        </div>
      </div>

      <!-- 6 CORE VALUES GRID -->
      <div class="pt-8">
        <div class="text-center max-w-3xl mx-auto mb-12 space-y-3">
          <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-gold-50 text-gold-700 text-xs font-bold uppercase tracking-wider border border-gold-200">
            Landasan Kerja Perusahaan
          </div>
          <h3 class="text-2xl sm:text-3xl font-bold text-navy-950 tracking-tight">
            6 Nilai Utama (Core Values)
          </h3>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
          {CORE_VALUES.map((val, idx) => (
            <div class="p-6 bg-white border border-slate-200/90 hover:border-gold-500/50 rounded-2xl transition-all duration-300 hover:-translate-y-1 space-y-3 shadow-sm">
              <div class="flex items-center justify-between">
                <span class="w-8 h-8 rounded-lg bg-navy-50 text-navy-900 font-extrabold flex items-center justify-center text-xs border border-navy-100">
                  0{idx + 1}
                </span>
                <Users class="w-5 h-5 text-slate-400" />
              </div>
              <h4 class="text-base font-bold text-navy-950">{val.title}</h4>
              <p class="text-xs text-slate-600 leading-relaxed">{val.description}</p>
            </div>
          ))}
        </div>
      </div>
    </div>
  </section>

  <!-- 5 LAYANAN UTAMA WITH PHOTOS - ID: layanan -->
  <section id="layanan" class="py-20 bg-white border-b border-slate-200 scroll-mt-20">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 space-y-16">
      <div class="text-center max-w-3xl mx-auto mb-16 space-y-4">
        <div class="inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full bg-gold-50 text-gold-700 text-xs font-bold uppercase tracking-wider border border-gold-200">
          5 Pilar Layanan Utama
        </div>
        <h2 class="text-3xl sm:text-4xl font-extrabold text-navy-950 tracking-tight">
          Solusi Bawah Laut & Marine Engineering Lengkap
        </h2>
        <p class="text-slate-600 text-sm sm:text-base">
          Didukung foto operasional asli, diver profesional, sertifikasi UWILD, dan perlengkapan selam standar maritim internasional.
        </p>
      </div>

      <div class="space-y-16">
        {SERVICES.map((service, idx) => (
          <div id={service.id} class="p-8 sm:p-10 bg-slate-50 border border-slate-200 rounded-3xl space-y-8 scroll-mt-28 relative overflow-hidden shadow-md">
            <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 items-center border-b border-slate-200 pb-8">
              <!-- Left Header & Info -->
              <div class="lg:col-span-7 space-y-4">
                <div class="flex items-center gap-4">
                  <div class="w-14 h-14 rounded-2xl bg-navy-900 text-gold-400 flex items-center justify-center shadow-md flex-shrink-0">
                    {idx === 0 && <Search class="w-7 h-7" />}
                    {idx === 1 && <Wrench class="w-7 h-7" />}
                    {idx === 2 && <Ship class="w-7 h-7" />}
                    {idx === 3 && <Anchor class="w-7 h-7" />}
                    {idx === 4 && <MapPin class="w-7 h-7" />}
                  </div>
                  <div>
                    <span class="text-xs font-mono font-bold text-gold-600 uppercase tracking-widest">Pilar Layanan 0{idx + 1}</span>
                    <h3 class="text-2xl sm:text-3xl font-extrabold text-navy-950 tracking-tight">{service.title}</h3>
                  </div>
                </div>

                <p class="text-slate-700 text-base leading-relaxed">
                  {service.shortDesc}
                </p>

                <div>
                  <a
                    href="https://wa.me/6281372154234"
                    target="_blank"
                    rel="noopener noreferrer"
                    class="inline-flex items-center justify-center px-6 py-3 text-xs font-extrabold text-navy-950 bg-gold-400 hover:bg-gold-500 rounded-xl transition-colors shadow-sm"
                  >
                    Inkuiri Layanan Ini
                    <ArrowRight class="w-4 h-4 ml-1.5" />
                  </a>
                </div>
              </div>

              <!-- Right Image Showcase -->
              <div class="lg:col-span-5">
                <div class="relative h-64 sm:h-72 rounded-2xl overflow-hidden border border-slate-200 shadow-md group">
                  <img
                    src={service.image}
                    alt={service.title}
                    class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500"
                  />
                  <div class="absolute inset-0 bg-gradient-to-t from-navy-950/60 via-transparent to-transparent"></div>
                  <span class="absolute bottom-3 left-3 text-xs font-bold text-white bg-navy-900/90 px-3 py-1 rounded-md">
                    PT. Fiona Operational Asset
                  </span>
                </div>
              </div>
            </div>

            <!-- Subcategories Grid -->
            {service.subcategories && (
              <div class="grid grid-cols-1 md:grid-cols-2 gap-6 pt-2">
                {service.subcategories.map((sub) => (
                  <div class="p-6 bg-white border border-slate-200 rounded-2xl space-y-3">
                    <h4 class="text-sm font-extrabold text-navy-900 uppercase tracking-wider flex items-center gap-2">
                      <span class="w-2 h-2 rounded-full bg-gold-500"></span>
                      {sub.title}
                    </h4>
                    <ul class="space-y-2 text-xs text-slate-700">
                      {sub.items.map((item) => (
                        <li class="flex items-start gap-2">
                          <CheckCircle2 class="w-4 h-4 text-emerald-600 flex-shrink-0 mt-0.5" />
                          <span class="leading-relaxed">{item}</span>
                        </li>
                      ))}
                    </ul>
                  </div>
                ))}
              </div>
            )}

            <!-- Hydrographic Special Callout Card -->
            {service.id === 'hydrographic-surveying' && (
              <div class="p-6 bg-navy-900 text-white rounded-2xl space-y-3 shadow-md">
                <div class="flex items-center gap-3">
                  <Cpu class="w-6 h-6 text-cyan-300" />
                  <h4 class="text-base font-bold text-white">Kapabilitas Khusus Hydrographic & Survey Vessel</h4>
                </div>
                <p class="text-xs text-slate-200 leading-relaxed">
                  Tim surveyor hydrographic kami berorientasi pada standar nasional & internasional untuk survei kedalaman bathymetric dan investigasi alur pipa offshore. Didukung peralatan GNSS RTK state-of-the-art, kapal survei tersertifikasi kelas 2C, dual-frequency & multi-beam sounder, serta perangkat lunak reduksi data presisi tinggi.
                </p>
              </div>
            )}
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- 20 EQUIPMENT FLEET SHOWCASE - ID: peralatan -->
  <section id="peralatan" class="py-20 bg-slate-50 border-b border-slate-200 scroll-mt-20">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center max-w-3xl mx-auto mb-16 space-y-4">
        <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-gold-50 text-gold-700 text-xs font-bold uppercase tracking-wider border border-gold-200">
          Standard Technical Assets
        </div>
        <h2 class="text-3xl font-bold text-navy-950 tracking-tight">
          Daftar Lengkap Armada & Peralatan Selam (Equipment Fleet)
        </h2>
        <p class="text-slate-600 text-sm">
          Seluruh 20 unit perlengkapan teknis diservis berkala untuk menjamin keamanan operasi di lapangan.
        </p>
      </div>

      <div class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-3 lg:grid-cols-4 gap-4">
        {EQUIPMENT_FLEET.map((item) => (
          <div class="p-5 bg-white border border-slate-200/80 hover:border-gold-500/50 rounded-2xl space-y-2 transition-all hover:-translate-y-0.5 shadow-sm">
            <div class="flex items-center justify-between text-xs">
              <span class="px-2 py-0.5 rounded bg-slate-100 text-navy-900 font-mono font-bold text-[10px] border border-slate-200">#0{item.id}</span>
              <span class="text-[10px] text-slate-500 uppercase tracking-wider font-semibold">{item.category}</span>
            </div>
            <h3 class="text-sm font-extrabold text-navy-950">{item.name}</h3>
            {item.description && (
              <p class="text-xs text-slate-600 leading-normal">{item.description}</p>
            )}
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- PROYEK TRACK RECORD - ID: proyek -->
  <section id="proyek" class="py-20 bg-white border-b border-slate-200 scroll-mt-20">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 space-y-12">
      <div class="text-center max-w-3xl mx-auto space-y-4">
        <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-navy-50 text-navy-900 text-xs font-bold uppercase tracking-wider border border-navy-200">
          Proven Track Record
        </div>
        <h2 class="text-3xl font-bold text-navy-950 tracking-tight">
          Pengalaman Proyek (16 Track Record Executed)
        </h2>
        <p class="text-slate-600 text-sm">
          Dokumentasi rekam jejak pekerjaan bawah laut yang sukses dilaksanakan di Galang Anchorage, Batu Ampar, PaxOcean, Bintan, Kotabaru, dan perairan Indonesia.
        </p>
      </div>

      <!-- Category Filter Tabs -->
      <div class="flex flex-wrap items-center justify-center gap-2.5" id="project-filters">
        <button
          data-filter="all"
          class="filter-btn px-4 py-2 text-xs font-extrabold rounded-xl transition-all border border-gold-500 bg-gold-400 text-navy-950 shadow-sm"
        >
          Semua Proyek (16)
        </button>
        <button
          data-filter="Hull Cleaning"
          class="filter-btn px-4 py-2 text-xs font-bold rounded-xl transition-all border border-slate-300 bg-white text-slate-700 hover:border-gold-500/50"
        >
          Hull Cleaning & Propeller (6)
        </button>
        <button
          data-filter="Video Survey"
          class="filter-btn px-4 py-2 text-xs font-bold rounded-xl transition-all border border-slate-300 bg-white text-slate-700 hover:border-gold-500/50"
        >
          Video Survey (4)
        </button>
        <button
          data-filter="Subsea Repair"
          class="filter-btn px-4 py-2 text-xs font-bold rounded-xl transition-all border border-slate-300 bg-white text-slate-700 hover:border-gold-500/50"
        >
          Subsea & Buoy Repair (2)
        </button>
        <button
          data-filter="Hydrographic & Inspection"
          class="filter-btn px-4 py-2 text-xs font-bold rounded-xl transition-all border border-slate-300 bg-white text-slate-700 hover:border-gold-500/50"
        >
          Survey & Inspection (2)
        </button>
        <button
          data-filter="Underwater Works"
          class="filter-btn px-4 py-2 text-xs font-bold rounded-xl transition-all border border-slate-300 bg-white text-slate-700 hover:border-gold-500/50"
        >
          Underwater Works (2)
        </button>
      </div>

      <!-- Projects Grid -->
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6" id="projects-grid">
        {PROJECT_TRACK_RECORD.map((project) => (
          <div
            data-category={project.category}
            class="project-card p-6 bg-slate-50 border border-slate-200 hover:border-gold-500/50 rounded-2xl space-y-4 transition-all duration-300 hover:-translate-y-1 shadow-sm"
          >
            <div class="flex items-center justify-between">
              <span class="px-3 py-1 rounded bg-navy-50 text-navy-900 text-xs font-bold border border-navy-100">
                {project.category}
              </span>
              <div class="flex items-center gap-1 text-xs text-slate-600 font-mono font-semibold">
                <Calendar class="w-3.5 h-3.5 text-gold-600" />
                <span>{project.date}</span>
              </div>
            </div>

