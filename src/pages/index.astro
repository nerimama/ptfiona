---
import BaseLayout from '../layouts/BaseLayout.astro';
import { COMPANY_INFO, SERVICES, PROJECT_TRACK_RECORD, CLIENT_LIST } from '../data/companyData';
import { Anchor, ShieldCheck, Award, Users, Search, Wrench, Ship, MapPin, ArrowRight, PhoneCall, CheckCircle2, Waves, Activity } from 'lucide-astro';

const featuredProjects = PROJECT_TRACK_RECORD.slice(0, 6);
---

<BaseLayout title={`${COMPANY_INFO.name} - Commercial Diving & Marine Salvage Experts Batam`}>
  <!-- HERO SECTION - WHITE & MARINE LIGHT THEME WITH HERO IMAGE -->
  <section class="relative bg-white overflow-hidden py-16 lg:py-24 border-b border-slate-200">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10">
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 items-center">
        <!-- Hero Text -->
        <div class="lg:col-span-7 space-y-6 text-left">
          <div class="inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full bg-navy-50 border border-navy-200 text-navy-900 text-xs font-bold uppercase tracking-wider shadow-sm">
            <Anchor class="w-4 h-4 text-gold-600" />
            <span>Kontraktor Terkemuka Batam & Kepulauan Riau</span>
          </div>

          <h1 class="text-4xl sm:text-5xl lg:text-6xl font-extrabold text-navy-950 tracking-tight leading-tight">
            <span class="block text-navy-950">{COMPANY_INFO.name}</span>
            <span class="block bg-gradient-to-r from-ocean-600 via-navy-800 to-gold-600 bg-clip-text text-transparent mt-2">
              Marine Salvage & Subsea Engineering
            </span>
          </h1>

          <p class="text-base sm:text-lg text-slate-600 max-w-2xl font-normal leading-relaxed">
            Spesialis penyelaman komersial (<strong class="text-navy-900">Commercial Diving</strong>), pembersihan lunas kapal (<strong class="text-navy-900">Underwater Hull Cleaning</strong>), inspeksi <strong class="text-navy-900">UWILD</strong>, perbaikan struktur bawah laut, dan survei <strong class="text-navy-900">Hydrographic Surveying</strong> profesional berbasis di Batam, Indonesia.
          </p>

          <!-- Action Buttons -->
          <div class="flex flex-col sm:flex-row items-center gap-4 pt-2">
            <a
              href="/services"
              class="w-full sm:w-auto inline-flex items-center justify-center px-8 py-4 text-sm font-extrabold text-navy-950 uppercase tracking-wider bg-gold-400 hover:bg-gold-500 rounded-xl transition-all duration-300 shadow-md hover:shadow-gold-500/40 transform hover:-translate-y-0.5"
            >
              Explore Services & Fleet
              <ArrowRight class="w-4 h-4 ml-2" />
            </a>
            <a
              href="/contact"
              class="w-full sm:w-auto inline-flex items-center justify-center px-8 py-4 text-sm font-bold text-slate-800 bg-slate-100 hover:bg-slate-200 border border-slate-300 rounded-xl transition-all duration-300"
            >
              Hubungi Tim Teknis
            </a>
          </div>

          <!-- Trust Badges -->
          <div class="pt-6 border-t border-slate-200 flex flex-wrap items-center gap-6 text-xs text-slate-600">
            <div class="flex items-center gap-2">
              <CheckCircle2 class="w-4.5 h-4.5 text-emerald-600" />
              <span class="font-semibold text-slate-800">Certified Commercial Divers</span>
            </div>
            <div class="flex items-center gap-2">
              <CheckCircle2 class="w-4.5 h-4.5 text-emerald-600" />
              <span class="font-semibold text-slate-800">Class Approved UWILD Surveys</span>
            </div>
            <div class="flex items-center gap-2">
              <CheckCircle2 class="w-4.5 h-4.5 text-emerald-600" />
              <span class="font-semibold text-slate-800">Advanced Subsea Fleet</span>
            </div>
          </div>
        </div>

        <!-- Hero Image Card showcase -->
        <div class="lg:col-span-5 relative">
          <div class="relative mx-auto max-w-md lg:max-w-none">
            <div class="relative bg-white border border-slate-200 rounded-3xl p-3 shadow-2xl space-y-4 overflow-hidden">
              <div class="relative h-72 sm:h-80 rounded-2xl overflow-hidden group">
                <img
                  src="/images/hero.png"
                  alt="PT Fiona Lintas Servis Commercial Diving Operation"
                  class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-700"
                />
                <div class="absolute inset-0 bg-gradient-to-t from-navy-950/80 via-transparent to-transparent"></div>
                <div class="absolute bottom-4 left-4 right-4 text-white">
                  <span class="px-2.5 py-1 rounded bg-gold-500 text-navy-950 text-[10px] font-black uppercase tracking-wider mb-1 inline-block">
                    Operational Excellence
                  </span>
                  <h3 class="text-base font-bold text-white">Kirby Morgan Commercial Diving Helmet & Umbilical Air System</h3>
                </div>
              </div>

              <!-- Quick Info List -->
              <div class="p-4 bg-slate-50 rounded-2xl border border-slate-200/80 space-y-2 text-xs">
                <div class="flex justify-between items-center text-slate-700">
                  <span class="font-bold text-navy-900">Coverage Area:</span>
                  <span class="font-medium">Galang, Batu Ampar, PaxOcean, Bintan, Singapore Strait</span>
                </div>
                <div class="flex justify-between items-center text-slate-700">
                  <span class="font-bold text-navy-900">Standard Response:</span>
                  <span class="font-semibold text-emerald-700">24/7 Rapid Dispatch</span>
                </div>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- STATS HIGHLIGHTS BANNER - WHITE & NAVY CONTRAST -->
  <section class="bg-navy-900 text-white py-12 border-b border-navy-800">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="grid grid-cols-2 md:grid-cols-4 gap-8 divide-y md:divide-y-0 md:divide-x divide-navy-800">
        <div class="text-center pt-4 md:pt-0">
          <div class="text-3xl lg:text-4xl font-black text-gold-400 tracking-tight">10+ Tahun</div>
          <div class="text-xs text-slate-300 uppercase tracking-widest mt-1 font-semibold">Pengalaman Maritim</div>
        </div>
        <div class="text-center pt-4 md:pt-0">
          <div class="text-3xl lg:text-4xl font-black text-white tracking-tight">16+ Proyek</div>
          <div class="text-xs text-slate-300 uppercase tracking-widest mt-1 font-semibold">Rekam Jejak Tuntas</div>
        </div>
        <div class="text-center pt-4 md:pt-0">
          <div class="text-3xl lg:text-4xl font-black text-cyan-300 tracking-tight">100% Certified</div>
          <div class="text-xs text-slate-300 uppercase tracking-widest mt-1 font-semibold">Diver & NDT Expert</div>
        </div>
        <div class="text-center pt-4 md:pt-0">
          <div class="text-3xl lg:text-4xl font-black text-gold-400 tracking-tight">24/7 Service</div>
          <div class="text-xs text-slate-300 uppercase tracking-widest mt-1 font-semibold">Respon Darurat Salvage</div>
        </div>
      </div>
    </div>
  </section>

  <!-- OVERVIEW & VISION SECTION -->
  <section class="py-20 bg-slate-50">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 items-center">
        <div class="lg:col-span-6 space-y-6">
          <div class="inline-flex items-center gap-2 px-3 py-1 rounded-md bg-ocean-50 text-ocean-700 text-xs font-bold uppercase tracking-wider border border-ocean-200">
            Tentang Perusahaan
          </div>
          <h2 class="text-3xl sm:text-4xl font-bold text-navy-950 tracking-tight leading-snug">
            Mitra Terpercaya Pekerjaan Bawah Laut & Marine Salvage di Indonesia
          </h2>
          <p class="text-slate-600 text-sm sm:text-base leading-relaxed">
            PT. Fiona Lintas Servis didirikan sebagai perusahaan lokal yang dinamis dengan tim ahli berpengalaman dalam industri <strong class="text-navy-900">Commercial Diving</strong>, perbaikan fasilitas pelabuhan, inspeksi NDT, serta hydrographic survey.
          </p>
          <p class="text-slate-600 text-sm leading-relaxed">
            Beroperasi dari pusat strategis Batam, Kepulauan Riau, kami siap melayani kebutuhan kapal, rig lepas pantai, dan pipa bawah laut di seluruh wilayah perairan Indonesia dan Selat Singapura.
          </p>

          <div class="pt-4 grid grid-cols-1 sm:grid-cols-2 gap-4">
            <div class="p-5 bg-white border border-slate-200 rounded-2xl shadow-sm">
              <h4 class="text-xs font-extrabold text-gold-600 uppercase tracking-wider mb-1">Visi Perusahaan</h4>
              <p class="text-xs text-slate-700 leading-normal">
                "Being a leading diversified entity through excellence in our core business."
              </p>
            </div>
            <div class="p-5 bg-white border border-slate-200 rounded-2xl shadow-sm">
              <h4 class="text-xs font-extrabold text-ocean-600 uppercase tracking-wider mb-1">Lokasi Strategis</h4>
              <p class="text-xs text-slate-700 leading-normal">
                Sekupang, Batam — Dekat dengan anchorage Galang, Batu Ampar, Tg. Uncang, dan Bintan.
              </p>
            </div>
          </div>

          <div>
            <a
              href="/about"
              class="inline-flex items-center text-sm font-extrabold text-ocean-600 hover:text-navy-900 transition-colors"
            >
              Baca Selengkapnya Tentang Kami
              <ArrowRight class="w-4 h-4 ml-1.5" />
            </a>
          </div>
        </div>

        <!-- Visual Core Values Card -->
        <div class="lg:col-span-6">
          <div class="p-8 bg-white border border-slate-200 rounded-3xl space-y-6 shadow-xl">
            <h3 class="text-xl font-bold text-navy-950 border-b border-slate-200 pb-4 flex items-center justify-between">
              <span>Nilai-Nilai Utama (Core Values)</span>
              <Award class="w-6 h-6 text-gold-500" />
            </h3>
            <div class="grid grid-cols-1 sm:grid-cols-2 gap-4 text-xs">
              <div class="p-4 bg-slate-50 border border-slate-200 rounded-xl">
                <span class="font-bold text-navy-900 block mb-1">1. Customer Focus</span>
                <span class="text-slate-600">Memenuhi dan melampaui harapan pelanggan dengan komitmen penuh.</span>
              </div>
              <div class="p-4 bg-slate-50 border border-slate-200 rounded-xl">
                <span class="font-bold text-navy-900 block mb-1">2. Honesty & Integrity</span>
                <span class="text-slate-600">Pondasi kepercayaan dalam setiap proyek dan pekerjaan.</span>
              </div>
              <div class="p-4 bg-slate-50 border border-slate-200 rounded-xl">
                <span class="font-bold text-navy-900 block mb-1">3. Trust</span>
                <span class="text-slate-600">Membangun kepercayaan dengan mengutamakan kebutuhan klien.</span>
              </div>
              <div class="p-4 bg-slate-50 border border-slate-200 rounded-xl">
                <span class="font-bold text-navy-900 block mb-1">4. Knowledge Sharing</span>
                <span class="text-slate-600">Budaya saling berbagi pengetahuan teknis & inovasi.</span>
              </div>
              <div class="p-4 bg-slate-50 border border-slate-200 rounded-xl">
                <span class="font-bold text-navy-900 block mb-1">5. Collaborative Teamwork</span>
                <span class="text-slate-600">Kerja sama tim sebagai kapabilitas strategis utama.</span>
              </div>
              <div class="p-4 bg-slate-50 border border-slate-200 rounded-xl">
                <span class="font-bold text-navy-900 block mb-1">6. Commitment to Excellence</span>
                <span class="text-slate-600">Dedikasi terbaik di setiap detail pekerjaan.</span>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- 5 MAIN SERVICES PILLARS GRID WITH SERVICE PHOTOS -->
  <section class="py-20 bg-white border-t border-b border-slate-200">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center max-w-3xl mx-auto mb-16 space-y-4">
        <div class="inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full bg-gold-50 text-gold-700 text-xs font-bold uppercase tracking-wider border border-gold-200">
          5 Pilar Layanan Utama
        </div>
        <h2 class="text-3xl sm:text-4xl font-extrabold text-navy-950 tracking-tight">
          Solusi Bawah Laut & Marine Engineering Lengkap
        </h2>
        <p class="text-slate-600 text-sm sm:text-base">
          Didukung foto operasional asli, diver profesional, sertifikasi UWILD, dan perlengkapan selam standar maritim internasional.
        </p>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
        {SERVICES.map((service, index) => (
          <div class="bg-white border border-slate-200 hover:border-gold-500/60 rounded-3xl overflow-hidden flex flex-col justify-between transition-all duration-300 hover:-translate-y-1.5 shadow-lg hover:shadow-xl group">
            <div class="space-y-4">
              <!-- Service Image Header -->
              <div class="relative h-48 overflow-hidden bg-slate-100">
                <img
                  src={service.image}
                  alt={service.title}
                  class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500"
                />
                <div class="absolute inset-0 bg-gradient-to-t from-navy-950/70 via-transparent to-transparent"></div>
                <div class="absolute top-3 left-3 w-10 h-10 rounded-xl bg-white/90 backdrop-blur-md border border-slate-200 flex items-center justify-center text-navy-900 shadow-md">
                  {index === 0 && <Search class="w-5 h-5" />}
                  {index === 1 && <Wrench class="w-5 h-5" />}
                  {index === 2 && <Ship class="w-5 h-5" />}
                  {index === 3 && <Anchor class="w-5 h-5" />}
                  {index === 4 && <MapPin class="w-5 h-5" />}
                </div>
                <span class="absolute bottom-3 right-3 text-xs font-mono font-bold text-white bg-navy-900/80 px-2.5 py-1 rounded">
                  0{index + 1}
                </span>
              </div>

              <!-- Content Body -->
              <div class="px-6 space-y-3">
                <h3 class="text-lg font-extrabold text-navy-950 group-hover:text-ocean-600 transition-colors">
                  {service.title}
                </h3>

                <p class="text-slate-600 text-xs leading-relaxed">
                  {service.shortDesc}
                </p>

                <ul class="space-y-1.5 pt-2 text-xs text-slate-700">
                  {service.details.map((detail) => (
                    <li class="flex items-start gap-2">
                      <span class="w-1.5 h-1.5 rounded-full bg-gold-500 mt-1.5 flex-shrink-0"></span>
                      <span>{detail}</span>
                    </li>
                  ))}
                </ul>
              </div>
            </div>

            <div class="p-6 pt-4 mt-4 border-t border-slate-100">
              <a
                href={`/services#${service.id}`}
                class="inline-flex items-center text-xs font-extrabold text-navy-900 group-hover:text-gold-600 transition-colors"
              >
                Detail Layanan & Peralatan
                <ArrowRight class="w-3.5 h-3.5 ml-1.5 transition-transform group-hover:translate-x-1" />
              </a>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- FEATURED PROJECTS RECENT HIGHLIGHTS -->
  <section class="py-20 bg-slate-50 border-b border-slate-200">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="flex flex-col md:flex-row justify-between items-start md:items-end mb-12 gap-4">
        <div>
          <div class="inline-flex items-center gap-2 px-3 py-1 rounded-md bg-navy-50 text-navy-900 text-xs font-bold uppercase tracking-wider border border-navy-200 mb-3">
            Track Record
          </div>
          <h2 class="text-3xl font-bold text-navy-950 tracking-tight">
            Pengalaman Proyek Terbaru
          </h2>
          <p class="text-slate-600 text-sm mt-1">
            Beberapa rekam jejak pekerjaan underwater hull cleaning, survey video, dan perbaikan subsea.
          </p>
        </div>
        <a
          href="/projects"
          class="inline-flex items-center px-5 py-2.5 text-xs font-bold text-navy-950 bg-white border border-slate-300 hover:bg-slate-100 rounded-xl transition-colors shadow-sm"
        >
          Lihat Semua 16 Proyek
          <ArrowRight class="w-4 h-4 ml-1.5" />
        </a>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
        {featuredProjects.map((project) => (
          <div class="p-6 bg-white border border-slate-200 rounded-2xl hover:border-gold-500/50 transition-all shadow-sm hover:shadow-md space-y-3">
            <div class="flex items-center justify-between text-xs">
              <span class="px-2.5 py-1 rounded bg-navy-50 text-navy-900 font-bold border border-navy-100">
                {project.category}
              </span>
              <span class="text-slate-600 font-mono font-semibold">{project.date}</span>
            </div>
            <h3 class="text-base font-extrabold text-navy-950 leading-snug">
              {project.title}
            </h3>
            <div class="flex items-center gap-1.5 text-xs text-slate-600 pt-1 border-t border-slate-100">
              <MapPin class="w-3.5 h-3.5 text-ocean-600 flex-shrink-0" />
              <span>{project.location}</span>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- CLIENT SHOWCASE GRID -->
  <section class="py-20 bg-white border-b border-slate-200">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center max-w-2xl mx-auto mb-12 space-y-3">
        <h2 class="text-2xl sm:text-3xl font-bold text-navy-950 tracking-tight">
          Klien & Partner Industri Maritim
        </h2>
        <p class="text-slate-600 text-sm">
          Dipercaya oleh perusahaan pelayaran, pengelola offshore, dan industri maritim ternama.
        </p>
      </div>

      <div class="grid grid-cols-2 sm:grid-cols-3 lg:grid-cols-4 gap-4">
        {CLIENT_LIST.map((client) => (
          <div class="p-5 bg-slate-50 border border-slate-200/80 rounded-2xl flex flex-col justify-center items-center text-center hover:border-gold-500/50 hover:bg-white transition-all duration-300 shadow-sm">
            <span class="text-sm font-bold text-navy-950 tracking-wide">{client.name}</span>
            <span class="text-[10px] text-slate-600 mt-1 uppercase tracking-widest font-semibold">{client.type}</span>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- CTA BANNER -->
  <section class="py-16 bg-navy-900 text-white relative">
    <div class="max-w-5xl mx-auto px-4 text-center space-y-6">
      <h2 class="text-3xl font-extrabold text-white">
        Butuh Layanan Salvage atau Commercial Diving Segera?
      </h2>
      <p class="text-slate-200 text-base max-w-2xl mx-auto">
        Tim respons cepat kami di Batam siap menangani inspeksi UWILD, hull cleaning, perbaikan struktur bawah laut, dan hydrographic survey.
      </p>
      <div class="flex flex-col sm:flex-row items-center justify-center gap-4 pt-2">
        <a
          href="https://wa.me/6281372154234"
          target="_blank"
          rel="noopener noreferrer"
          class="w-full sm:w-auto inline-flex items-center justify-center px-8 py-3.5 text-sm font-extrabold text-navy-950 bg-gold-400 hover:bg-gold-500 rounded-xl transition-all shadow-md"
        >
          <PhoneCall class="w-4 h-4 mr-2" />
          Hubungi Operations Manager (Sukri)
        </a>
        <a
          href="/contact"
          class="w-full sm:w-auto inline-flex items-center justify-center px-8 py-3.5 text-sm font-bold text-white bg-navy-950 border border-navy-700 hover:bg-navy-800 rounded-xl transition-colors"
        >
          Kirim Formulir Inkuiri
        </a>
      </div>
    </div>
  </section>
</BaseLayout>
