---
import { COMPANY_INFO } from '../data/companyData';
import { Anchor, MapPin, Phone, Mail, MessageSquare, ArrowUpRight, ShieldCheck } from 'lucide-astro';
---

<footer class="bg-gradient-to-b from-slate-950 via-navy-950 to-slate-950 border-t border-slate-800 text-slate-400 relative overflow-hidden">
  <!-- Subtle decorative grid background overlay -->
  <div class="absolute inset-0 bg-[linear-gradient(to_right,#1e293b_1px,transparent_1px),linear-gradient(to_bottom,#1e293b_1px,transparent_1px)] bg-[size:4rem_4rem] [mask-image:radial-gradient(ellipse_60%_50%_at_50%_0%,#000_70%,transparent_100%)] opacity-20 pointer-events-none"></div>

  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-16 relative z-10">
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-12 gap-12">
      <!-- Column 1: Company Profile (4 cols) -->
      <div class="lg:col-span-4 space-y-6">
        <div class="flex items-center gap-3">
          <div class="w-10 h-10 rounded-lg bg-navy-900 border border-gold-500/50 flex items-center justify-center text-gold-400 shadow-glow">
            <Anchor class="w-5 h-5" />
          </div>
          <span class="text-xl font-extrabold text-white tracking-wide">PT. FIONA LINTAS SERVIS</span>
        </div>
        <p class="text-sm text-slate-300 leading-relaxed">
          Kontraktor terkemuka di bidang <strong class="text-gold-400 font-medium">Commercial Diving</strong>, <strong class="text-gold-400 font-medium">Marine Salvage</strong>, <strong class="text-gold-400 font-medium">Subsea Engineering</strong>, dan <strong class="text-gold-400 font-medium">Hydrographic Surveying</strong> berbasis di Batam, Indonesia.
        </p>
        <div class="flex items-center gap-3 p-3.5 bg-slate-900/80 border border-slate-800 rounded-xl">
          <ShieldCheck class="w-6 h-6 text-emerald-400 flex-shrink-0" />
          <div class="text-xs">
            <p class="text-slate-200 font-semibold">Quality & Safety Standards</p>
            <p class="text-slate-400">Tim penyelam profesional bersertifikasi nasional & internasional.</p>
          </div>
        </div>
      </div>

      <!-- Column 2: Quick Links (2 cols) -->
      <div class="lg:col-span-2 space-y-4">
        <h3 class="text-sm font-bold text-white uppercase tracking-wider border-b border-slate-800 pb-2">Navigasi</h3>
        <ul class="space-y-2.5 text-sm">
          <li><a href="/" class="hover:text-gold-400 transition-colors flex items-center gap-1 group"><span>Beranda</span><ArrowUpRight class="w-3.5 h-3.5 opacity-0 group-hover:opacity-100 transition-opacity" /></a></li>
          <li><a href="/about" class="hover:text-gold-400 transition-colors flex items-center gap-1 group"><span>Tentang Kami</span><ArrowUpRight class="w-3.5 h-3.5 opacity-0 group-hover:opacity-100 transition-opacity" /></a></li>
          <li><a href="/services" class="hover:text-gold-400 transition-colors flex items-center gap-1 group"><span>Layanan Utama</span><ArrowUpRight class="w-3.5 h-3.5 opacity-0 group-hover:opacity-100 transition-opacity" /></a></li>
          <li><a href="/projects" class="hover:text-gold-400 transition-colors flex items-center gap-1 group"><span>Pengalaman Proyek</span><ArrowUpRight class="w-3.5 h-3.5 opacity-0 group-hover:opacity-100 transition-opacity" /></a></li>
          <li><a href="/contact" class="hover:text-gold-400 transition-colors flex items-center gap-1 group"><span>Hubungi Kami</span><ArrowUpRight class="w-3.5 h-3.5 opacity-0 group-hover:opacity-100 transition-opacity" /></a></li>
        </ul>
      </div>

      <!-- Column 3: Contact Info (3 cols) -->
      <div class="lg:col-span-3 space-y-4">
        <h3 class="text-sm font-bold text-white uppercase tracking-wider border-b border-slate-800 pb-2">Kantor & Workshop</h3>
        <ul class="space-y-3 text-sm">
          <li class="flex items-start gap-3">
            <MapPin class="w-5 h-5 text-gold-400 mt-0.5 flex-shrink-0" />
            <span class="text-slate-300 leading-snug">{COMPANY_INFO.address}</span>
          </li>
          <li class="flex items-center gap-3">
            <Phone class="w-4 h-4 text-gold-400 flex-shrink-0" />
            <span class="text-slate-300">Tel: {COMPANY_INFO.phone} | Fax: {COMPANY_INFO.fax}</span>
          </li>
          <li class="flex items-start gap-3">
            <Mail class="w-4 h-4 text-gold-400 mt-1 flex-shrink-0" />
            <div class="flex flex-col text-xs text-slate-300 gap-1">
              <a href={`mailto:${COMPANY_INFO.emails[0]}`} class="hover:text-cyan-400 transition-colors">{COMPANY_INFO.emails[0]}</a>
              <a href={`mailto:${COMPANY_INFO.emails[1]}`} class="hover:text-cyan-400 transition-colors">{COMPANY_INFO.emails[1]}</a>
            </div>
          </li>
        </ul>
      </div>

      <!-- Column 4: Contact Persons / WhatsApp (3 cols) -->
      <div class="lg:col-span-3 space-y-4">
        <h3 class="text-sm font-bold text-white uppercase tracking-wider border-b border-slate-800 pb-2">Kontak Person Direct</h3>
        <div class="space-y-3">
          {COMPANY_INFO.contactPersons.map((cp) => (
            <div class="p-3 bg-slate-900/90 rounded-xl border border-slate-800 hover:border-gold-500/40 transition-colors">
              <div class="flex justify-between items-center mb-1">
                <span class="text-white font-bold text-sm">{cp.name}</span>
                <span class="text-[10px] text-gold-400 uppercase tracking-wider bg-gold-500/10 px-2 py-0.5 rounded border border-gold-500/20">{cp.role}</span>
              </div>
              <p class="text-xs text-slate-400 mb-2">{cp.phone}</p>
              <a
                href={cp.waLink}
                target="_blank"
                rel="noopener noreferrer"
                class="inline-flex items-center justify-center gap-1.5 w-full py-1.5 px-3 text-xs font-semibold text-emerald-950 bg-emerald-400 hover:bg-emerald-300 rounded-lg transition-colors"
              >
                <MessageSquare class="w-3.5 h-3.5" />
                Chat WhatsApp {cp.name}
              </a>
            </div>
          ))}
        </div>
      </div>
    </div>

    <!-- Bottom Bar -->
    <div class="mt-12 pt-8 border-t border-slate-800/80 flex flex-col md:flex-row justify-between items-center gap-4 text-xs text-slate-400">
      <p>© {new Date().getFullYear()} PT. FIONA LINTAS SERVIS. All rights reserved.</p>
      <p class="flex items-center gap-2">
        <span>Batam, Kepulauan Riau - Indonesia</span>
        <span>•</span>
        <span class="text-gold-400">Offshore & Subsea Specialists</span>
      </p>
    </div>
  </div>
</footer>
