---
import { COMPANY_INFO } from '../data/companyData';
import { MapPin, Phone, Mail, MessageSquare, ArrowUpRight, ShieldCheck } from 'lucide-astro';
---

<footer class="bg-navy-950 text-slate-300 border-t border-navy-900 relative overflow-hidden">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-16 relative z-10">
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-12 gap-12">
      <!-- Column 1: Company Profile with logo.png -->
      <div class="lg:col-span-4 space-y-6">
        <div class="flex items-center gap-3">
          <div class="p-2 bg-white/95 rounded-xl border border-slate-200 inline-block shadow-md">
            <img
              src="/logo.png"
              alt="PT. Fiona Lintas Servis Logo"
              class="h-12 w-auto object-contain"
            />
          </div>
        </div>
        <p class="text-sm text-slate-300 leading-relaxed">
          Kontraktor terkemuka di bidang <strong class="text-gold-400 font-medium">Commercial Diving</strong>, <strong class="text-gold-400 font-medium">Marine Salvage</strong>, <strong class="text-gold-400 font-medium">Subsea Engineering</strong>, dan <strong class="text-gold-400 font-medium">Hydrographic Surveying</strong> berbasis di Batam, Indonesia.
        </p>
        <div class="flex items-center gap-3 p-3.5 bg-navy-900/80 border border-navy-800 rounded-xl">
          <ShieldCheck class="w-6 h-6 text-emerald-400 flex-shrink-0" />
          <div class="text-xs">
            <p class="text-white font-semibold">Quality & Safety Standards</p>
            <p class="text-slate-400">Tim penyelam profesional bersertifikasi nasional & internasional.</p>
          </div>
        </div>
      </div>

      <!-- Column 2: Quick Links -->
      <div class="lg:col-span-2 space-y-4">
        <h3 class="text-sm font-bold text-white uppercase tracking-wider border-b border-navy-800 pb-2">Navigasi</h3>
        <ul class="space-y-2.5 text-sm">
          <li><a href="#beranda" class="hover:text-gold-400 transition-colors flex items-center gap-1 group"><span>Beranda</span><ArrowUpRight class="w-3.5 h-3.5 opacity-0 group-hover:opacity-100 transition-opacity" /></a></li>
          <li><a href="#tentang" class="hover:text-gold-400 transition-colors flex items-center gap-1 group"><span>Tentang Kami</span><ArrowUpRight class="w-3.5 h-3.5 opacity-0 group-hover:opacity-100 transition-opacity" /></a></li>
          <li><a href="#layanan" class="hover:text-gold-400 transition-colors flex items-center gap-1 group"><span>Layanan Utama</span><ArrowUpRight class="w-3.5 h-3.5 opacity-0 group-hover:opacity-100 transition-opacity" /></a></li>
          <li><a href="#peralatan" class="hover:text-gold-400 transition-colors flex items-center gap-1 group"><span>Equipment Fleet</span><ArrowUpRight class="w-3.5 h-3.5 opacity-0 group-hover:opacity-100 transition-opacity" /></a></li>
          <li><a href="#proyek" class="hover:text-gold-400 transition-colors flex items-center gap-1 group"><span>Rekam Jejak</span><ArrowUpRight class="w-3.5 h-3.5 opacity-0 group-hover:opacity-100 transition-opacity" /></a></li>
          <li><a href="#kontak" class="hover:text-gold-400 transition-colors flex items-center gap-1 group"><span>Kontak Kami</span><ArrowUpRight class="w-3.5 h-3.5 opacity-0 group-hover:opacity-100 transition-opacity" /></a></li>
        </ul>
      </div>

      <!-- Column 3: Contact Info -->
      <div class="lg:col-span-3 space-y-4">
        <h3 class="text-sm font-bold text-white uppercase tracking-wider border-b border-navy-800 pb-2">Kantor & Workshop</h3>
        <ul class="space-y-3 text-sm">
          <li class="flex items-start gap-3">
            <MapPin class="w-5 h-5 text-gold-400 mt-0.5 flex-shrink-0" />
            <span class="text-slate-300 leading-snug">{COMPANY_INFO.address}</span>
          </li>
          <li class="flex items-center gap-3">
            <Phone class="w-4 h-4 text-gold-400 flex-shrink-0" />
            <span class="text-slate-300">Tel: {COMPANY_INFO.phone} | Fax: {COMPANY_INFO.fax}</span>
          </li>
          <li class="flex items-start gap-3">
            <Mail class="w-4 h-4 text-gold-400 mt-1 flex-shrink-0" />
            <div class="flex flex-col text-xs text-slate-300 gap-1">
              <a href={`mailto:${COMPANY_INFO.emails[0]}`} class="hover:text-gold-400 transition-colors">{COMPANY_INFO.emails[0]}</a>
              <a href={`mailto:${COMPANY_INFO.emails[1]}`} class="hover:text-gold-400 transition-colors">{COMPANY_INFO.emails[1]}</a>
            </div>
          </li>
        </ul>
      </div>

      <!-- Column 4: Contact Persons -->
      <div class="lg:col-span-3 space-y-4">
        <h3 class="text-sm font-bold text-white uppercase tracking-wider border-b border-navy-800 pb-2">Kontak Person Direct</h3>
        <div class="space-y-3">
          {COMPANY_INFO.contactPersons.map((cp) => (
            <div class="p-3 bg-navy-900/90 rounded-xl border border-navy-800 hover:border-gold-500/40 transition-colors">
              <div class="flex justify-between items-center mb-1">
                <span class="text-white font-bold text-sm">{cp.name}</span>
                <span class="text-[10px] text-gold-400 uppercase tracking-wider bg-gold-500/10 px-2 py-0.5 rounded border border-gold-500/20">{cp.role}</span>
              </div>
              <p class="text-xs text-slate-400 mb-2">{cp.phone}</p>
              <a
                href={cp.waLink}
                target="_blank"
                rel="noopener noreferrer"
                class="inline-flex items-center justify-center gap-1.5 w-full py-1.5 px-3 text-xs font-semibold text-navy-950 bg-gold-400 hover:bg-gold-500 rounded-lg transition-colors shadow-sm"
              >
                <MessageSquare class="w-3.5 h-3.5 text-navy-950" />
                Chat WhatsApp {cp.name}
              </a>
            </div>
          ))}
        </div>
      </div>
    </div>

    <!-- Bottom Bar -->
    <div class="mt-12 pt-8 border-t border-navy-900 flex flex-col md:flex-row justify-between items-center gap-4 text-xs text-slate-400">
      <p>© {new Date().getFullYear()} PT. FIONA LINTAS SERVIS. All rights reserved.</p>
      <p class="flex items-center gap-2">
        <span>Batam, Kepulauan Riau - Indonesia</span>
        <span>•</span>
        <span class="text-gold-400">Offshore & Subsea Specialists</span>
      </p>
    </div>
  </div>
</footer>
