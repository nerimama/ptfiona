---
import { COMPANY_INFO } from '../data/companyData';
import { PhoneCall, Menu, X, Waves } from 'lucide-astro';

const navLinks = [
  { name: 'Beranda', href: '#beranda' },
  { name: 'Tentang Kami', href: '#tentang' },
  { name: 'Layanan', href: '#layanan' },
  { name: 'Peralatan', href: '#peralatan' },
  { name: 'Proyek', href: '#proyek' },
  { name: 'Klien', href: '#klien' },
  { name: 'Kontak', href: '#kontak' }
];
---

<header class="sticky top-0 z-50 bg-white/95 backdrop-blur-md border-b border-slate-200/90 shadow-sm transition-all duration-300">
  <!-- Top bar info -->
  <div class="bg-navy-900 text-xs py-1.5 px-4 text-slate-200">
    <div class="max-w-7xl mx-auto flex justify-between items-center">
      <div class="flex items-center gap-6">
        <span class="flex items-center gap-1.5 text-slate-100">
          <span class="inline-block w-2 h-2 rounded-full bg-emerald-400 animate-pulse"></span>
          Batam, Indonesia Hub
        </span>
        <span class="flex items-center gap-1.5 hover:text-gold-300 transition-colors">
          <PhoneCall class="w-3.5 h-3.5 text-gold-400" />
          <a href={`tel:${COMPANY_INFO.phone}`}>{COMPANY_INFO.phone}</a>
        </span>
        <span class="hidden md:inline text-slate-300">
          Email: <a href={`mailto:${COMPANY_INFO.emails[0]}`} class="text-white hover:text-gold-300 underline">{COMPANY_INFO.emails[0]}</a>
        </span>
      </div>
      <div class="flex items-center gap-4">
        <span class="text-gold-400 font-semibold tracking-wide text-[11px] sm:text-xs">24/7 Commercial Diving & Marine Response</span>
      </div>
    </div>
  </div>

  <!-- Main Navbar -->
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="flex justify-between items-center h-20">
      <!-- Main Logo Image -->
      <a href="#beranda" class="flex items-center gap-3 group">
        <img
          src="/logo.png"
          alt="PT. Fiona Lintas Servis Logo"
          class="h-12 w-auto object-contain max-w-[180px] sm:max-w-[220px]"
        />
      </a>

      <!-- Desktop Nav Links -->
      <nav class="hidden lg:flex items-center space-x-1 xl:space-x-2">
        {navLinks.map((link) => (
          <a
            href={link.href}
            class="px-3.5 py-2 rounded-lg text-sm font-bold text-slate-700 hover:text-navy-900 hover:bg-slate-100/80 transition-all duration-200"
          >
            {link.name}
          </a>
        ))}
      </nav>

      <!-- CTA Button -->
      <div class="hidden lg:flex items-center gap-3">
        <a
          href="https://wa.me/6281372154234"
          target="_blank"
          rel="noopener noreferrer"
          class="relative inline-flex items-center justify-center px-5 py-2.5 text-xs font-extrabold text-navy-950 uppercase tracking-wider bg-gold-400 hover:bg-gold-500 rounded-lg transition-all duration-300 shadow-md hover:shadow-gold-500/30 transform hover:-translate-y-0.5"
        >
          <Waves class="w-4 h-4 mr-1.5 text-navy-950 animate-bounce" />
          Hubungi Tim 24/7
        </a>
      </div>

      <!-- Mobile menu button -->
      <div class="flex lg:hidden items-center">
        <button
          type="button"
          id="mobile-menu-btn"
          class="p-2.5 rounded-lg bg-slate-100 text-slate-700 hover:text-slate-900 hover:bg-slate-200 border border-slate-300 focus:outline-none"
          aria-label="Toggle Navigation Menu"
        >
          <Menu id="menu-icon-open" class="w-6 h-6 block" />
          <X id="menu-icon-close" class="w-6 h-6 hidden" />
        </button>
      </div>
    </div>
  </div>

  <!-- Mobile Navigation Drawer -->
  <div id="mobile-menu" class="hidden lg:hidden bg-white border-b border-slate-200 px-4 pt-3 pb-6 space-y-2 shadow-lg">
    {navLinks.map((link) => (
      <a
        href={link.href}
        class="block px-4 py-3 rounded-lg text-base font-bold text-slate-700 hover:text-navy-900 hover:bg-slate-100 transition-colors"
      >
        {link.name}
      </a>
    ))}
    <div class="pt-4 border-t border-slate-200 space-y-3">
      <a
        href="https://wa.me/6281372154234"
        target="_blank"
        rel="noopener noreferrer"
        class="w-full inline-flex items-center justify-center px-5 py-3 text-sm font-bold text-navy-950 bg-gold-400 rounded-lg hover:bg-gold-500 transition-colors shadow-sm"
      >
        Hubungi Operations (Sukri)
      </a>
      <a
        href="https://wa.me/6281357515108"
        target="_blank"
        rel="noopener noreferrer"
        class="w-full inline-flex items-center justify-center px-5 py-3 text-sm font-bold text-slate-800 bg-slate-100 border border-slate-300 rounded-lg hover:bg-slate-200 transition-colors"
      >
        Hubungi Commercial (Fionna)
      </a>
    </div>
  </div>
</header>

<script>
  const menuBtn = document.getElementById('mobile-menu-btn');
  const mobileMenu = document.getElementById('mobile-menu');
  const openIcon = document.getElementById('menu-icon-open');
  const closeIcon = document.getElementById('menu-icon-close');

  if (menuBtn && mobileMenu) {
    menuBtn.addEventListener('click', () => {
      mobileMenu.classList.toggle('hidden');
      if (openIcon && closeIcon) {
        openIcon.classList.toggle('hidden');
        closeIcon.classList.toggle('hidden');
      }
    });

    // Close mobile menu when clicking a link
    const mobileLinks = mobileMenu.querySelectorAll('a');
    mobileLinks.forEach(link => {
      link.addEventListener('click', () => {
        mobileMenu.classList.add('hidden');
        if (openIcon && closeIcon) {
          openIcon.classList.remove('hidden');
          closeIcon.classList.add('hidden');
        }
      });
    });
  }
</script>
